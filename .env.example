# Local-first. Do not bind to 0.0.0.0 without authentication, HTTPS, and rate limits.
VIETFRAME_DATA=./workspace
VIETFRAME_HOST=127.0.0.1
VIETFRAME_PORT=8010
MAX_UPLOAD_MB=350
MAX_DURATION_SECONDS=1800
# Optional: stable Fernet key for credential encryption on a hosted server.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# VIETFRAME_CREDENTIAL_ENCRYPTION_KEY=
# Optional local model; requires faster-whisper and model download.
WHISPER_MODEL=small
# Optional local generation, GPU required.
ENABLE_LOCAL_VIDEO_GEN=false
VIDEO_MODEL_ID=THUDM/CogVideoX-2b
# Optional locally self-hosted Kokoro compatible TTS endpoint; see README.
KOKORO_TTS_URL=
# If your self-hosted KokoroTTS local server uses auth, set this server-side only.
KOKORO_TTS_API_KEY=
# Required for first owner creation over a remote address; keep secret, never commit real value.
VIETFRAME_SETUP_TOKEN=
# Set true in production behind HTTPS reverse proxy.
VIETFRAME_COOKIE_SECURE=false

# Optional Sign in with Google (Cloud Console > Google Auth Platform > Clients).
# Register redirect URI exactly: https://vietframe-studio-app.onrender.com/api/auth/google/callback
VIETFRAME_GOOGLE_CLIENT_ID=
VIETFRAME_GOOGLE_CLIENT_SECRET=
VIETFRAME_GOOGLE_ALLOWED_EMAIL=
VIETFRAME_GOOGLE_ORIGIN=https://vietframe-studio-app.onrender.com

# Hosted production: use a Neon Postgres connection string in Render Secret Environment
# VIETFRAME_CREDENTIALS_DATABASE_URL=postgresql://...@.../vietframe?sslmode=require
# VIETFRAME_REQUIRE_PERSISTENT_KEYS=true
